# For Uniform CLI auth (register/install scripts)
UNIFORM_API_KEY=

# Default team ID to use for Uniform CLI
UNIFORM_TEAM_ID=

# Default project ID to use for Uniform CLI
UNIFORM_PROJECT_ID=

# --- Identity delegation (Content Ops Toolkit BFF) ---

# Origin for the Uniform token/platform APIs.
# https://uniform.app for US-region teams, https://eu.uniform.app for EU.
UNIFORM_API_HOST=https://uniform.app

# Integration definition ID (UUID) and app secret, from
# Uniform dashboard > Team > Settings > Custom Integrations
# (the secret is only issued once delegation is enabled).
UNIFORM_INTEGRATION_ID=
UNIFORM_INTEGRATION_SECRET=

# Cookie encryption secret (min 32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MESH_SESSION_SECRET=

# Comma-separated origins allowed to call the state-changing BFF routes
# (the origin the mesh app iframe is served from).
MESH_ALLOWED_ORIGINS=https://localhost:9000
