# --- DataForSEO (https://app.dataforseo.com/api-access) -------------------
# Server-side only: used by app/lib/server/dataforseo.ts via the /api/* proxy
# routes. Never exposed to the browser. Long term these move to a
# Uniform-operated backend so customers never handle DataForSEO credentials.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# How long cached DataForSEO responses stay fresh (hours). The dashboard's
# "Refresh data" button always bypasses the cache. Default: 24.
# DATAFORSEO_CACHE_TTL_HOURS=24

# --- logo.dev (https://www.logo.dev/) ------------------------------------
# Publishable token used to render company/competitor logos by domain. It is
# embedded in the logo image URLs, so it is safe for the browser and MUST use
# the NEXT_PUBLIC_ prefix. Get one from https://www.logo.dev/dashboard.
# When unset, the dashboard falls back to monogram badges instead of logos.
NEXT_PUBLIC_LOGO_DEV_TOKEN=
